# Groq (https://console.groq.com/keys) - used for routing, answering and SQL generation
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Secret used to sign login tokens: any random string of 32+ characters,
# e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIBOT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Leave unset to use the embedded on-disk Qdrant store in ./.qdrant
# Set to e.g. http://localhost:6333 to use a Qdrant server instead.
# QDRANT_URL=

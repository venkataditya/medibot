# Groq (https://console.groq.com/keys) - used for routing, answering and SQL generation
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Secret used to sign login tokens. Any long random string.
MEDIBOT_SECRET=change-me-to-a-long-random-string

# Leave unset to use the embedded on-disk Qdrant store in ./.qdrant
# Set to e.g. http://localhost:6333 to use a Qdrant server instead.
# QDRANT_URL=
